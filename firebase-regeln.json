// EMBER — Regeln für die Echtzeit-Datenbank.
// In der Firebase-Konsole unter Realtime Database -> Regeln einfügen und
// veröffentlichen. Diese Kommentarzeilen versteht Firebase.
{
  "rules": {
    ".read": false,
    ".write": false,

    "paare": {
      "$paar": {

        // Der Pfadname ist aus eurem Schlüssel abgeleitet und hat 128 Bit
        // Entropie: erraten lässt er sich nicht. Diese Regeln sind die
        // zweite Linie dahinter — selbst mit bekanntem Pfad kommen nur
        // eingetragene Geräte heran.
        ".read": "auth != null && data.child('mitglieder').hasChild(auth.uid)",
        ".write": "auth != null && (data.child('mitglieder').hasChild(auth.uid) || data.child('mitglieder').numChildren() < 6)",

        "mitglieder": {
          // Ein Gerät trägt nur sich selbst ein, nie ein anderes. Sechs
          // Plätze, damit Handy, Tablet und Laptop hineinpassen — und ein
          // geleertes Gerät wieder zurückkann (es bekommt beim Neuanmelden
          // eine neue Kennung). Ist der Bereich voll: in der Konsole unter
          // paare/<euer Pfad>/mitglieder alte Einträge löschen.
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (data.exists() || data.parent().numChildren() < 6)",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
